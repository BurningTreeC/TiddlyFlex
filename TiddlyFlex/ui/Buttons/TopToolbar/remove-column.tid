title: $:/plugins/BTC/TiddlyFlex/ui/Buttons/TopToolbar/remove-column
caption: {{$:/core/images/minus-button}} Close last column
description: Close the last column
tags: $:/tags/TopRightBar $:/tags/PageControls
list-before: $:/plugins/BTC/TiddlyFlex/ui/Buttons/TopToolbar/add-column

\whitespace trim
<%if [tdff.tiddlyflex-layout[]] %>
	<$let
		stateTiddlerPrefix="$:/state/resizable-flexbox-story/"
		columnsActual={{{ [list[$:/columns]count[]] }}}
		columns={{{ [<columnsActual>!match[0]] ~1 }}}
		nextColumn={{{ [<columns>subtract[1]!match[0]] ~1 }}}

		lastColumn={{{ [list[$:/columns]last[]] }}}
		newLastColumn={{{ [list[$:/columns]butlast[]last[]] ~1 }}}

		oldCellWidthNumeric={{{ [[100]divide<columns>fixed[6]] }}}
		removedColumnWidthNumeric={{{ [<stateTiddlerPrefix>addsuffix[col-]addsuffix<lastColumn>get[text]removesuffix[%]else<oldCellWidthNumeric>fixed[6]] }}}
		cellDiff={{{ [<removedColumnWidthNumeric>divide<nextColumn>fixed[6]] }}}

		canRemoveColumn={{{ [<columns>compare:number:gt[1]then[yes]else[no]] }}}
		removeColumnTooltip={{{ [<canRemoveColumn>match[yes]then[remove column]else[cannot remove the last column]] }}}
	>
		<$button
			class=<<tv-config-toolbar-class>>
			tooltip=<<removeColumnTooltip>>
			disabled={{{ [<canRemoveColumn>match[no]then[yes]] }}}
		>
			<%if [<canRemoveColumn>match[yes]] %>

				<!-- If the active column is the removed column, move active state to the new last column. -->
				<$list filter="[[$:/columns]get[current-column]match<lastColumn>]">
					<$action-setfield
						$tiddler="$:/columns"
						current-column=<<newLastColumn>>
					/>
				</$list>

				<!--
				Each remaining column receives the same amount:
				removedColumnWidth / remainingColumnCount.
				-->
				<$list filter="[list[$:/columns]butlast[]]" variable="column">
					<$action-setfield
						$tiddler={{{ [<stateTiddlerPrefix>addsuffix[col-]addsuffix<column>] }}}
						text={{{ [<stateTiddlerPrefix>addsuffix[col-]addsuffix<column>get[text]removesuffix[%]else<oldCellWidthNumeric>add<cellDiff>fixed[6]addsuffix[%]] }}}
					/>
				</$list>

				<!-- Remove the last column from the list. -->
				<$action-listops
					$tiddler="$:/columns"
					$subfilter="-[<lastColumn>]"
				/>

				<!-- Delete stale state for the removed column. -->
				<$action-deletetiddler
					$tiddler={{{ [<stateTiddlerPrefix>addsuffix[col-]addsuffix<lastColumn>] }}}
				/>

			<% endif %>

			<$list filter="[<tv-config-toolbar-icons>match[yes]]">
				{{$:/core/images/minus-button}}
			</$list>

			<$list filter="[<tv-config-toolbar-text>match[yes]]">
				<span class="tc-btn-text">
					<$text text="Remove a column"/>
				</span>
			</$list>
		</$button>
	</$let>
<% endif %>