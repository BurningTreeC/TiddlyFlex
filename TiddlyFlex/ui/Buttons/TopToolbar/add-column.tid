title: $:/plugins/BTC/TiddlyFlex/ui/Buttons/TopToolbar/add-column
caption: {{$:/core/images/plus-button}} Add a column
description: Add an additional column at the right
tags: $:/tags/TopRightBar $:/tags/PageControls
list-before: $:/core/ui/TopBar/menu

\whitespace trim
<%if [tdff.tiddlyflex-layout[]] %>
	<$let
		stateTiddlerPrefix="$:/state/resizable-flexbox-story/"
		columnsActual={{{ [list[$:/columns]count[]] }}}
		columns={{{ [<columnsActual>!match[0]] ~1 }}}
		nextColumn={{{ [<columns>add[1]] }}}

		minColumnWidth="15"
		canAddColumn={{{ [<nextColumn>multiply<minColumnWidth>compare:number:lteq[100]then[yes]else[no]] }}}

		oldCellWidthNumeric={{{ [[100]divide<columns>fixed[6]] }}}
		newColumnWidthNumeric={{{ [[100]divide<nextColumn>fixed[6]] }}}
		newColumnWidth={{{ [<newColumnWidthNumeric>fixed[6]addsuffix[%]] }}}

		cellDiff={{{ [[0]subtract<newColumnWidthNumeric>divide<columns>fixed[6]] }}}

		addColumnTooltip={{{ [<canAddColumn>match[yes]then[add column]else[maximum column count reached]] }}}
	>
		<$button
			class=<<tv-config-toolbar-class>>
			tooltip=<<addColumnTooltip>>
			disabled={{{ [<canAddColumn>match[no]then[yes]] }}}
		>
			<%if [<canAddColumn>match[yes]] %>

				<!-- Materialize implicit column 1 if needed. -->
				<%if [<columnsActual>match[0]] %>
					<$action-listops
						$tiddler="$:/columns"
						$subfilter="1"
					/>

					<$action-setfield
						$tiddler={{{ [<stateTiddlerPrefix>addsuffix[col-1]] }}}
						text={{{ [<oldCellWidthNumeric>add<cellDiff>fixed[6]addsuffix[%]] }}}
					/>
				<% endif %>

				<!-- Existing columns all lose the same amount: newColumnWidth / existingColumnCount. -->
				<$list filter="[list[$:/columns]]" variable="column">
					<$action-setfield
						$tiddler={{{ [<stateTiddlerPrefix>addsuffix[col-]addsuffix<column>] }}}
						text={{{ [<stateTiddlerPrefix>addsuffix[col-]addsuffix<column>get[text]removesuffix[%]else<oldCellWidthNumeric>add<cellDiff>fixed[6]addsuffix[%]] }}}
					/>
				</$list>

				<!-- Add and initialize the new column explicitly. -->
				<$action-listops
					$tiddler="$:/columns"
					$subfilter="[<nextColumn>]"
				/>

				<$action-setfield
					$tiddler={{{ [<stateTiddlerPrefix>addsuffix[col-]addsuffix<nextColumn>] }}}
					text=<<newColumnWidth>>
				/>

			<% endif %>

			<$list filter="[<tv-config-toolbar-icons>match[yes]]">
				{{$:/core/images/plus-button}}
			</$list>

			<$list filter="[<tv-config-toolbar-text>match[yes]]">
				<span class="tc-btn-text">
					<$text text="Add a column"/>
				</span>
			</$list>
		</$button>
	</$let>
<% endif %>