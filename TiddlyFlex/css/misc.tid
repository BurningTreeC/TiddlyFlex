title: $:/plugins/BTC/TiddlyFlex/styles/misc
tags: $:/tags/Stylesheet

<%if [tdff.tiddlyflex-layout[]] %>

	.tc-tiddlyflex-sidebar .tc-sidebar-header {
		transition: none;
	}

	.tc-tiddlyflex-top-toolbar .tc-show-sidebar-btn svg.tc-image-chevron-left, .tc-tiddlyflex-top-toolbar .tc-hide-sidebar-btn svg.tc-image-chevron-right {
		transform: none;
	}

	.tc-modal-wrapper {
		z-index: 999;
	}

	.tc-plugin-reload-warning {
		position: relative;
		padding-top: 15px;
		padding-bottom: 15px;
	}

	.tc-plugin-reload-warning p {
		margin: 0;
	}

	.tc-drafts-list.tc-tiddlyflex-drafts-list {
		z-index: 997;
		position: absolute;
		font-size: 0.8em;
		left: 0;
		bottom: 0;
	}

	<%if [{$:/config/tiddlyflex/story-river/tiddler/show-controls-hover}match[yes]] %>

		@media (min-width: 992px) {

			.tc-tiddler-frame .tc-tiddler-controls {
				display: none;
				padding: 0;
			}

			.tc-tiddler-frame:hover .tc-tiddler-controls {
				display: block;
			}

		}

	<% endif %>

	.tc-flexbox-story-column-resizer-flexbox {
		position: absolute;
		right: -4px;
		top: 0;
		bottom: 0;
		width: 8px;
		cursor: col-resize;
		z-index: 501;
		background: transparent;
	}

	.tc-tiddlyflex-hide-bars-button {
		position: fixed;
		bottom: 30px;
		right: 30px;
		width: 30px;
		height: 30px;
		z-index: 999999;
	}

	.tc-tiddlyflex-hide-bars-button:hover {
		opacity: 1;
	}

	.tc-tiddlyflex-hide-bars-button button svg {
		fill: <<colour muted-foreground>>;
		height: 30px;
		width: 30px;
	}

	.tc-tiddlyflex-hide-bars-button button:hover svg {
		fill: <<colour foreground>>;
	}

	<%if [{$:/state/tiddlyflex/hidden-bars}match[yes]] %>

		.tc-tiddlyflex-header, .tc-tiddlyflex-footer, .tc-tiddlyflex-leftbar, .tc-tiddlyflex-sidebar {
			display: none;
		}

		.tc-tiddlyflex-story-river-container {
			flex-basis: 100%;
			width: 100%;
		}

		.tc-tiddlyflex-story-river-wrapper-inner .tc-tiddlyflex-story-river {
			padding: 10px;
		}

		.tc-tiddlyflex-story-river-inner > .tc-tiddler-view-frame, .tc-tiddlyflex-story-river-inner > .tc-tiddler-edit-frame {
			margin-bottom: 10px;
		}

		.tc-tiddler-frame {
			padding: 14px 21px 21px 21px;
		}

	<% endif %>

<% endif %>